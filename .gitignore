# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- framework .gitignore ---
# Biến môi trường
.env
.env*.local
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template
# Linh tinh
# Bytecode cache Python (scripts/*.py sinh ra khi chạy/test các engine)
__pycache__/
*.pyc
# Khai bao lenh dev dac thu du an (copy tu .claude/project-commands.example.sh)
.claude/project-commands.sh
# Permission/setting ca nhan (copy tu .claude/settings.local.json.example) — khong dung chung
.claude/settings.local.json
# MCP server ca nhan/co bi mat that (copy mau tu .mcp.json.example)
.mcp.local.json
# Trạng thái cục bộ của Claude Code (checkpoint trước compaction)
.claude/.compact-checkpoint
# Dữ liệu cục bộ do bộ công cụ cũ sinh ra trên máy đã clone trước 2026-11-22 — không commit
.ai-telemetry/
.hermes/

# Công cụ quy trình: trạng thái autopilot cục bộ, settings cá nhân
.autopilot/

# Playwright
/test-results
/playwright-report
/.data/
